generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GlobalSchedule {
  key            String    @id
  value_date     DateTime
  last_execution DateTime?
}

model Puskesmas {
  id            String     @id @default(cuid())
  namaPuskesmas String     @unique
  alamatLengkap String?
  posyandu      Posyandu[]
}

model Posyandu {
  id            String     @id @default(cuid())
  namaPosyandu  String
  puskesmasId   String
  provinsi      String?
  kota          String?
  kecamatan     String?
  kelurahan     String
  rt            String?
  rw            String?
  alamatLengkap String?
  rekomendasi   DateTime   @default(now())
  tinjauan      String?
  ibu           IbuRumah[]
  kader         Kader[]
  puskesmas     Puskesmas  @relation(fields: [puskesmasId], references: [id])
}

model Kader {
  id            String      @id @default(cuid())
  email         String?     @unique
  namaPuskesmas String
  namaPosyandu  String
  provinsi      String
  kota          String
  kecamatan     String
  kelurahan     String
  rt            String
  rw            String
  kodePos       String?
  authId        String?     @unique
  noTelp        String?     @unique
  posyanduId    String?
  anakKader     AnakKader[]
  posyandu      Posyandu?   @relation(fields: [posyanduId], references: [id])
}

model IbuRumah {
  id         String    @id @default(cuid())
  email      String?   @unique
  provinsi   String
  nama       String
  kota       String
  kecamatan  String
  kelurahan  String
  rt         String
  rw         String
  kodePos    String?
  alamat     String
  usia       Int
  noTelp     String    @unique
  cekAnak    Boolean?
  sanitasi   Boolean?
  authId     String?   @unique
  posyanduId String?
  anakAnak   AnakIbu[] @relation("NewAnakIbu")
  posyandu   Posyandu? @relation(fields: [posyanduId], references: [id])
}

model AnakIbu {
  id           String       @id @default(cuid())
  emailIbu     String?
  nama         String
  usia         DateTime
  beratBadan   Float
  tinggiBadan  Float
  beratBadanL  Float?
  tinggiBadanL Float?
  stunting     StuntingType
  anemia       Boolean
  jenisKelamin String
  cekMingguan  Boolean      @default(false)
  zscore       Float?
  ibuId        String?
  ibu          IbuRumah?    @relation("NewAnakIbu", fields: [ibuId], references: [id])
  recapAnak    RecapAnak[]
}

model AnakKader {
  id                  String       @id @default(cuid())
  nama                String
  namaIbu             String
  usia                Int
  beratBadan          Float
  tinggiBadan         Float
  anemia              Boolean
  stunting            StuntingType
  jenisKelamin        String
  tanggal             DateTime?
  konjungtivitaNormal Boolean?
  kukuBersih          Boolean?
  tampakLemas         Boolean?
  tampakPucat         Boolean?
  riwayatAnemia       Boolean?
  kaderEmail          String?
  kaderId             String?
  kader               Kader?       @relation(fields: [kaderId], references: [id])
}

model RecapAnak {
  kodeRecap            String       @id @default(cuid())
  anakIbuId            String
  tanggal              DateTime
  beratBadan           Float
  tinggiBadan          Float
  usia                 Int
  anemia               Boolean
  stunting             StuntingType
  konjungtivitasNormal Boolean
  kukuBersih           Boolean
  riwayatAnemia        Boolean
  tampakLemas          Boolean
  tampakPucat          Boolean
  rekomendasi          String
  anakIbu              AnakIbu      @relation(fields: [anakIbuId], references: [id])
}

model Artikel {
  id      String   @id @default(cuid())
  judul   String
  tanggal DateTime
  konten  String
  gambar  String?
  tags    Tag[]    @relation("ArtikelTags")
}

model Tag {
  id      String    @id @default(cuid())
  nama    String    @unique
  artikel Artikel[] @relation("ArtikelTags")
}

enum StuntingType {
  SangatPendek
  Pendek
  Normal
  Tinggi
}
